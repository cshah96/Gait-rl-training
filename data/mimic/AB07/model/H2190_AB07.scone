# Model used in simulation
ModelHyfydy {
	model_file = H2190v2k.hfd

	# Set initial state
	state_init_file = InitStateGait10.zml
	fixed_control_step_size = 0.005
	initial_equilibration_activation = 0.05
	zero_velocity_equilibration = 1
	enable_dof_actuators = 0
	use_omnidirectional_root_dofs = 1
	<< neural_delays_FEA_v4.zml >>

	# --- subject scaling (scripts/mimic_build_subject.py) ---
	BodyModifier { include = "pelvis" scale = [ 0.9167 0.9167 0.8831 ] }
	BodyModifier { include = "femur_r;femur_l" scale = [ 1.1354 1.1354 1.1354 ] }
	BodyModifier { include = "tibia_r;tibia_l" scale = [ 0.9418 0.9418 0.9418 ] }
	BodyModifier { include = "calcn_r;calcn_l" scale = [ 1.0181 1.0181 1.0181 ] }
	BodyModifier { include = "torso" scale = [ 0.9167 0.9167 0.9167 ] }
	ModelModifier { mass = 55.30 }
}
